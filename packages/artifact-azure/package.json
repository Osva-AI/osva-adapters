{
  "name": "@osva-ai/adapter-artifact-azure",
  "version": "0.1.1",
  "description": "Azure Blob Storage ArtifactBlobStore adapter for OSVA (operator-configured credentials)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Osva-AI/osva-adapters.git",
    "directory": "packages/artifact-azure"
  },
  "homepage": "https://github.com/Osva-AI/osva-adapters/tree/main/packages/artifact-azure",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.ts --testNamePattern Azurite"
  },
  "dependencies": {
    "@azure/storage-blob": "catalog:",
    "@osva-ai/contracts": "1.1.0-rc.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
