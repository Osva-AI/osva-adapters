# syntax=docker/dockerfile:1
# Same as A1.4 — installs packed @osva-ai/adapter-artifact-azure into OSVA RC3 image.

ARG OSVA_BASE_IMAGE=osva:1.1.0-rc.3-a25-base
FROM ${OSVA_BASE_IMAGE}

USER root
WORKDIR /app

COPY adapter-artifact-azure.tgz /tmp/adapter-artifact-azure.tgz

RUN mkdir -p /tmp/adapter-unpack /app/node_modules/@osva-ai \
  && tar -xzf /tmp/adapter-artifact-azure.tgz -C /tmp/adapter-unpack \
  && rm -rf /app/node_modules/@osva-ai/adapter-artifact-azure \
  && mv /tmp/adapter-unpack/package /app/node_modules/@osva-ai/adapter-artifact-azure \
  && npm install \
    --prefix /app/node_modules/@osva-ai/adapter-artifact-azure \
    --omit=dev \
    --no-fund \
    --no-audit \
  && rm -rf /tmp/adapter-unpack /tmp/adapter-artifact-azure.tgz

USER node
